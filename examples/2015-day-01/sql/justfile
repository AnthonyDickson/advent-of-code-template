default:
    @just --list

# Check both solutions against the examples from the puzzle statement.
test:
    duckdb -batch -bail -no-init -noheader -list -f tests/test_aoc.sql

# Print both answers, one per line.
run:
    duckdb -batch -bail -no-init -noheader -list -f main.sql

# DuckDB has no compile step, so parse and bind the solution macros instead.
build:
    duckdb -batch -bail -no-init -noheader -list -c ".read src/aoc.sql"

benchmark *args:
    hyperfine --warmup 3 -N "duckdb -batch -bail -no-init -noheader -list -f main.sql" {{args}}
    time -v duckdb -batch -bail -no-init -noheader -list -f main.sql
