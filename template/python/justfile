default:
    @just --list

test:
    uv run pytest

run:
    uv run python main.py

# Create `.venv` from `uv.lock`, so later recipes run offline.
build:
    uv sync

lint:
    uv run ruff check

fmt:
    uv run ruff format

outdated:
    uv tree --outdated --depth 1

update:
    uv lock --upgrade

# Time the interpreter in `.venv` directly, so `uv run`'s own startup is not measured.
benchmark *args: build
    hyperfine --warmup 3 -N ".venv/bin/python main.py" {{args}}
    time -v .venv/bin/python main.py

clean:
    rm -rf .venv
